# =============================================================================
# CONTENT FACTORY - Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=content_factory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=content_factory

# -----------------------------------------------------------------------------
# AI Services API Keys
# -----------------------------------------------------------------------------

# Anthropic Claude - for script generation
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ElevenLabs - for voice synthesis
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# HeyGen - for AI avatar videos
# Get your key at: https://app.heygen.com/settings/api
HEYGEN_API_KEY=...

# FAL.ai - for Kling AI video generation (optional, cheaper alternative)
# Get your key at: https://fal.ai/dashboard/keys
FAL_API_KEY=...

# OpenAI - for Whisper transcription and DALL-E thumbnails (optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Publishing Platforms
# -----------------------------------------------------------------------------

# YouTube Data API v3
# Setup guide: https://developers.google.com/youtube/v3/getting-started
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...

# TikTok Content Posting API
# Setup guide: https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_ACCESS_TOKEN=...

# VK API
# Get token at: https://vk.com/apps?act=manage (create Standalone app)
VK_ACCESS_TOKEN=...
VK_GROUP_ID=...

# Telegram Bot
# Create bot via @BotFather and get token
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHANNEL_ID=...

# Instagram Graph API (via Facebook Business)
# Setup guide: https://developers.facebook.com/docs/instagram-api
INSTAGRAM_ACCESS_TOKEN=...
INSTAGRAM_ACCOUNT_ID=...

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Videos per week (default: 5)
VIDEOS_PER_WEEK=5

# Default video settings
DEFAULT_VIDEO_DURATION=45
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
