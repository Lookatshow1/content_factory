TZ=Europe/Amsterdam
RUN_TIMES=09:30,13:30,18:30
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=svf

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/svf
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=svf

API_BASE_URL=http://api:8000

LLM_PROVIDER_PRIMARY=yandex
LLM_PROVIDER_FALLBACK=openrouter
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.6
LLM_TIMEOUT=60
REPEAT_SIMILARITY_THRESHOLD=0.55
SERIES_MODE=round_robin
FACT_MODE=bank_only
PIPELINE_VERSION=v3
PIPELINE_ALLOWED=v1,v2,v3

# LLM provider secrets (set in real .env, do not commit)
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_API_KEY=__PUT_YOUR_KEY_HERE__
YANDEX_FOLDER_ID=__PUT_YOUR_FOLDER_ID_HERE__
YANDEX_MODEL=gpt://__FOLDER__/yandexgpt/latest

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=__PUT_YOUR_KEY_HERE__
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_HTTP_REFERER=https://example.com
OPENROUTER_X_TITLE=content-factory

LLM_MODEL_RESEARCHER=${YANDEX_MODEL}
LLM_MODEL_WRITER=${YANDEX_MODEL}
LLM_MODEL_EDITOR=${YANDEX_MODEL}
LLM_MODEL_JUDGE=${YANDEX_MODEL}
LLM_MODEL_FALLBACK=${OPENROUTER_MODEL}

TTS_PROVIDER=stub
TTS_TIMEOUT=60
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

VIDEO_BACKEND=ffmpeg
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_POLL_INTERVAL=20
HEYGEN_MAX_POLLS=10

PUBLISH_VK_ENABLED=false
PUBLISH_TIKTOK_ENABLED=false
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.131
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
